[Unit]
Description=DOSO Unified Single-Process Rust Brainstem Runtime
After=network.target brainstem-can.service doso-realtime-tune.service
Wants=network.target brainstem-can.service doso-realtime-tune.service
Conflicts=brainstem.service brainstem-dds-bridge.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=3s
User=sunrise
Group=sunrise
WorkingDirectory=/opt/doso/current
EnvironmentFile=-/etc/doso/robot-cloud/agent/agent.env
EnvironmentFile=-/etc/doso/brainstem.env
ExecStart=/opt/doso/current/bin/doso-brainstem
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillSignal=SIGTERM
CPUAffinity=4 5
Nice=-20
LimitMEMLOCK=infinity
LimitRTPRIO=95
IOSchedulingClass=realtime
IOSchedulingPriority=0
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=doso-brainstem

[Install]
WantedBy=multi-user.target
