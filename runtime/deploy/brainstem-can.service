[Unit]
Description=Bring up DOSO 4-Channel 1Mbps SocketCAN Interfaces
Before=doso-brainstem.service
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for dev in can0 can1 can2 can3; do if ip link show "$dev" >/dev/null 2>&1; then ip link set "$dev" down || true; ip link set "$dev" type can bitrate 1000000 restart-ms 100; ip link set "$dev" txqueuelen 64 up; fi; done'
ExecStop=/bin/sh -c 'for dev in can0 can1 can2 can3; do if ip link show "$dev" >/dev/null 2>&1; then ip link set "$dev" down || true; fi; done'

[Install]
WantedBy=multi-user.target
