# RDK S100 / S100P Real Robot Hardware Configuration (/etc/doso/brainstem.env)

# 4-channel SocketCAN backend (FR=can0, FL=can2, RR=can1, RL=can3)
DOSO_HAL_BACKEND=socketcan

# Declarative ONNX + Golden policy package root
DOSO_PACKAGES_DIR=/opt/doso/data/models/packages

# ONNX Runtime shared library & release libs
ONNXRUNTIME_DLL_PATH=/usr/local/lib/libonnxruntime.so
LD_LIBRARY_PATH=/opt/doso/current/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu

# Sensor & physical YunZhuo serial udev symlinks
DOSO_IMU_PORT=/dev/imu
DOSO_REMOTE_PORT=/dev/yunzhuo

# Onboard AskMe voice/agent HTTP endpoint
ASKME_ENDPOINT=http://127.0.0.1:8765

# SAFETY GATE: Safe default is false (read-only CAN listener, physical motor enable & CAN TX blocked).
# Change to true ONLY after confirming robot suspension/ground clearance and safety readiness.
THUNDER_ALLOW_MOTOR_ENABLE=false

# Unified single-process endpoints & POSIX SHM IPC
BRAINSTEM_BASE_GATEWAY_LISTEN=0.0.0.0:5052
DOSO_BRAINSTEM_LISTEN=127.0.0.1:13145
DOSO_LOCAL_STATUS_LISTEN=127.0.0.1:13146
DOSO_POLICY_ADMIN_LISTEN=127.0.0.1:5054
DOSO_FIRMWARE_VERSION=v0.0.1
DOSO_SHM_IPC_ENABLED=true
DOSO_SHM_PROPRIO_NAME=/doso_proprio_v1
DOSO_SHM_CMD_NAME=/doso_ext_cmd_v1
RUST_LOG=info
# Optional robot hardware parameter YAML override (defaults to embedded config/thunder_v4.yaml)
# DOSO_HARDWARE_CONFIG=/etc/doso/thunder_v4.yaml
