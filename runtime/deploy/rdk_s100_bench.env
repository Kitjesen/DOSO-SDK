# RDK S100P Benchtop Configuration (/etc/doso/brainstem.env)

# Zero-hardware synthetic proprioception backend for safe benchtop / CI verification
DOSO_HAL_BACKEND=bench

# Declarative ONNX + Golden policy package root
DOSO_PACKAGES_DIR=/opt/doso/data/models/packages

# ONNX Runtime shared library & release libs
ONNXRUNTIME_DLL_PATH=/usr/local/lib/libonnxruntime.so
LD_LIBRARY_PATH=/opt/doso/current/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu

# SAFETY GATE: Always false on benchtop
THUNDER_ALLOW_MOTOR_ENABLE=false

# Onboard AskMe voice/agent HTTP endpoint
ASKME_ENDPOINT=http://127.0.0.1:8765

# Unified single-process endpoints & POSIX SHM IPC
BRAINSTEM_BASE_GATEWAY_LISTEN=0.0.0.0:5052
DOSO_BRAINSTEM_LISTEN=127.0.0.1:13145
DOSO_LOCAL_STATUS_LISTEN=127.0.0.1:13146
DOSO_POLICY_ADMIN_LISTEN=0.0.0.0:5054
DOSO_FIRMWARE_VERSION=v1.0.0-rust
DOSO_SHM_IPC_ENABLED=true
DOSO_SHM_PROPRIO_NAME=/doso_proprio_v1
DOSO_SHM_CMD_NAME=/doso_ext_cmd_v1
RUST_LOG=info
