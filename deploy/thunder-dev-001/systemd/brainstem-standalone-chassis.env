# /etc/brainstem/brainstem-standalone-chassis.env
# Standalone Board-A Motion Chassis mode (NO Board B / NO LingTu):
# - Serves unified customer doso.v1 gRPC on :5052 directly from Board A.
# - L1 (200Hz ExternalControl / RL) and L2 (Sport posture, Teleop, IMU/Joints/Motors) work natively.
# - L3 (Maps/Localization/Navigation/Tasks) cleanly report UNIMPLEMENTED and Capabilities=false.
# - Brainstem :13145 stays bound to 127.0.0.1 internal only.
BRAINSTEM_ENDPOINT=http://127.0.0.1:13145
BRAINSTEM_BASE_GATEWAY_LISTEN=0.0.0.0:5052
BRAINSTEM_DDS_ENABLED=false
BRAINSTEM_DDS_CLIENT_ID=local-grpc@bsrl1
BRAINSTEM_DDS_WATCHDOG_MS=250
DOSO_DEVICE_ID=THUNDER-DEV-001
DOSO_ROBOT_MODEL=thunder
DOSO_FIRMWARE_VERSION=v0.0.1
