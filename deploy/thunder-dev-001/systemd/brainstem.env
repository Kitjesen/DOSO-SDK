# /etc/brainstem/brainstem.env   (root:sunrise 0640)
#
# DRAFT 2026-11-20 — Brainstem 唯一环境文件（THUNDER-DEV-001）
#
# 第一次切换：值与 2026-11-20 17:01 启动的 PID 3232 的实际环境逐项等价，
# 只有路径换成 /opt/brainstem 规范目录（文件内容 sha256 相同，见 README.md）。
# 标注 [CHANGE-LATER] 的项是已知需要在后续独立变更中调整的安全/架构项，第一次切换不改。

# ---------- 进程基础环境（原 control_enabled.env 中的通用项） ----------
LANG=C.UTF-8
TZ=CST-08:00
LOGLEVEL=5
LD_HWCAP_MASK=0x00000000
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/hobot/bin:/app/bin:/middleware/bin:/var/busybox:/usr/local/sbin:/usr/local/bin

# ---------- 二进制与原生库 ----------
# libcserialport.so 与旧 LD_PRELOAD 的文件 sha256 相同 (fbfb06ba…)
LD_PRELOAD=/opt/brainstem/current/lib/libcserialport.so
LD_LIBRARY_PATH=/usr/local/lib:/opt/brainstem/current/lib:/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu:/app/lib:/app/pub/lib:/middleware/lib:/middleware/pub/lib:/usr/lib/gstreamer
ONNXRUNTIME_DLL_PATH=/usr/local/lib/libonnxruntime.so

# ---------- 日志 ----------
# 原来隐式写到 /home/sunrise/brainstem_mixed_can_stage_20261023_041903/logs
THUNDER_LOG_DIR=/var/log/brainstem

# ---------- gRPC 服务（阶段 1 双监听平滑共存：App 走 LAN :13145，本机边车走 127.0.0.1:13145 → :5052） ----------
THUNDER_PORT=13145
# lan-dev 模式下 Brainstem 会同时监听 LAN/热点地址（供 doso-app / G20 零中断使用）
# 以及 127.0.0.1:13145（供本机 brainstem-dds-bridge 以 local-grpc@bsrl1 代理 :5052 SDK），两者共用 ControlArbiter 互斥锁。
# [STAGE-2] 等 doso-app 迁移至 DOSO-SDK (:5052) 后，将下方改为：
#   THUNDER_GRPC_TRANSPORT=loopback
#   THUNDER_GRPC_LAN_ADDRESS=127.0.0.1
# 并注释掉 THUNDER_GRPC_ALLOWED_IPS / THUNDER_LINGTU_ALLOWED_IPS，即可彻底关闭外网 :13145。
THUNDER_GRPC_TRANSPORT=lan-dev
THUNDER_GRPC_LAN_ADDRESS=192.168.66.64
THUNDER_GRPC_ALLOWED_IPS=192.168.66.62,192.168.66.94,192.168.66.202
THUNDER_LINGTU_ALLOWED_IPS=192.168.66.62,192.168.66.94,192.168.66.202
THUNDER_GRPC_TLS_CERT_FILE=/etc/brainstem/tls/server.cert.pem
THUNDER_GRPC_TLS_KEY_FILE=/etc/brainstem/tls/server.key.pem
THUNDER_GRPC_TLS_CLIENT_CA_FILE=/etc/brainstem/tls/ca.cert.pem
THUNDER_LOCOMOTION_PRINCIPALS=doso-dev@robot=/etc/brainstem/tls/doso-dev@robot.crt

# ---------- 电机与硬件 ----------
# [CHANGE-LATER] 允许通过 gRPC 使能电机；需要收进 SafetyGate / 会话权限
THUNDER_ALLOW_MOTOR_ENABLE=true
THUNDER_RECEIVER_OBSERVE_ONLY=false
THUNDER_JOINT_TRANSPORT=rdk-s100-pcan
THUNDER_IMU_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_0e3a84e11af0ef11b457535a6d9880ab-if00-port0
THUNDER_YUNZHUO_PORT=/dev/yunzhuo

# ---------- 运行数据（版本独立于二进制） ----------
# 来源 deployments/thunder_w5_stairs_motion_slots_20261117_0e0115b
THUNDER_OPERATOR_MODES=/opt/brainstem/data/operator_modes.json
THUNDER_PROFILE_DIR=/opt/brainstem/data/profiles
# [STEP 1.1 DISABLED] 恢复模型与未验证 SHA/ONNX SafeIntOnOverflow 每次启动报错；
# 未验收前停用以止血，需要恢复实验时再取消注释：
# THUNDER_RECOVERY_MODEL_CONFIG=/opt/brainstem/data/recovery_model/model.json
# 来源 /home/sunrise/gesture-library/gestures（thunder_brain/lib/src/gesture.dart 读取）
THUNDER_GESTURE_CATALOG=/opt/brainstem/data/gestures/index.json
THUNDER_GESTURE_LIBRARY=/opt/brainstem/data/gestures/library.json
# 来源 thunder_receiver_20261030/deployment/runtime-data/xbox.json
THUNDER_XBOX_CONFIG=/opt/brainstem/data/xbox.json

# ---------- 本地 Web 控制（当前关闭，仅本机回环） ----------
THUNDER_WEB_CONTROL_ENABLED=false
THUNDER_WEB_HOST=127.0.0.1
THUNDER_WEB_PORT=8088
THUNDER_WEB_ASSETS=/opt/brainstem/data/web
THUNDER_WEB_TOKEN_FILE=/etc/brainstem/web_control.token

# ---------- 语音 ----------
THUNDER_VOICE_BACKEND=esp32
THUNDER_VOICE_PYTHON=python3
# 来源 /home/sunrise/voice_local_player_test_20261027/send_announcement.py（迁移前需确认其依赖）
THUNDER_VOICE_ESP32_SENDER=/opt/brainstem/libexec/voice/send_announcement.py

# ---------- 本地只读状态与控制器外围收敛（Step 1.3） ----------
# 开启本机回环 127.0.0.1:13146 只读 GetControlStatus（供 doso-cloud-link 轮询）
THUNDER_LOCAL_STATUS_ENABLED=true
# THUNDER_LOCAL_STATUS_PORT=13146
# Xbox/NC500 与 30s 策略热加载默认关闭，避免误劫持输入或引入磁盘/日志抖动
# THUNDER_XBOX_ENABLED=false
# THUNDER_PROFILE_HOT_RELOAD=false
# 未完成三端收敛与安全窗口验收前，在生产环境显式禁用 RobotExternalControl
THUNDER_EXTERNAL_ENABLED=false
# 产线电机零位写 Flash 默认锁死，只允许本机标定工具显式打开
THUNDER_FACTORY_CAL_ENABLED=false

# ---------- 高频遥测与 POSIX 共享内存无锁 IPC（Phase 1 + Phase 2） ----------
# 默认 100Hz 整帧 AllJoints（比旧版 1,600/s SingleJoint 降低 16 倍 gRPC 帧开销）；如需兼容旧单帧客户端改为 single
THUNDER_JOINT_STREAM_MODE=snapshot
THUNDER_JOINT_SNAPSHOT_PERIOD_MS=10
# 共享内存无锁数据面（控制面与 SafetyGate 仍走 gRPC 127.0.0.1:13145）。
# 部署好 /opt/brainstem/current/lib/libdoso_shm_ipc.so 后改为 true 即可灰度启用，改回 false 秒级回退 gRPC：
THUNDER_SHM_IPC_ENABLED=false
DOSO_SHM_IPC_LIB_PATH=/opt/brainstem/current/lib/libdoso_shm_ipc.so
THUNDER_SHM_PROPRIO_NAME=/doso_proprio_v1
THUNDER_SHM_PROPRIO_PERIOD_MS=5
THUNDER_SHM_CMD_NAME=/doso_ext_cmd_v1
THUNDER_SHM_CMD_PERIOD_MS=5

# 明确不再设置（旧 drop-in 中曾 Unset 或已失效）：
#   THUNDER_DUAL_POSTURE_CONFIG
#   THUNDER_NORMAL_RECOVERY_ENABLE_SEQUENCE_VERIFIED
#   HAN_DOG_*（旧 /etc/brainstem/brainstem.env 的内容，当前已被 drop-in 清空、未生效）
