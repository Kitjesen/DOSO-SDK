# /etc/systemd/system/brainstem-can.service
#
# DRAFT 2026-11-20 — 替换 thunder-w5-stairs-can-20261116.service
#
# 以 root 运行（需要 ip link set），只做两件事：
#   - 4 路 PCAN 按 USB 拓扑映射检查，DOWN 的设为 1 Mbps 并 UP；
#   - 确认 IMU 串口存在。
# 不发送任何电机 / CAN 帧。已经 UP 但波特率不对时直接失败，不打断。

[Unit]
Description=Brainstem PCAN link preparation (4x PCAN @1Mbps + IMU presence)
Before=brainstem.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 只需要 THUNDER_IMU_PORT；与 brainstem.service 共用同一份环境文件，避免两处配置
EnvironmentFile=/etc/brainstem/brainstem.env
ExecStart=/usr/bin/python3 /opt/brainstem/libexec/can-check.py
