# /etc/systemd/system/brainstem-dds-bridge.service
# Standalone Board-A Brainstem <-> LingTu CycloneDDS bridge (retires middleman lingtu_driver)

[Unit]
Description=Brainstem CycloneDDS Bridge (THUNDER-DEV-001)
After=network-online.target brainstem.service
Requires=brainstem.service
Conflicts=lingtu-driver.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sunrise
Group=sunrise
CPUAffinity=2 3
Nice=-10
EnvironmentFile=/etc/brainstem/brainstem-dds-bridge.env
ExecStart=/opt/brainstem/bridge/current/bin/brainstem-dds-bridge
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brainstem-dds-bridge

[Install]
WantedBy=multi-user.target
