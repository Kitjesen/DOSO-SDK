# /etc/brainstem/brainstem-dds-bridge.env
# Dual-board (Board A + Board B LingTu) mode:
# - CycloneDDS handles high-rate rt/* IPC between Brainstem (Board A) and LingTu (Board B).
# - Board-A Base Gateway listens on :5053 for zero-GIL L1 ExternalControl direct bypass
#   (advertised via Board B System.Handshake when DOSO_LOW_LEVEL_ENDPOINT=http://<board-a>:5053).
BRAINSTEM_ENDPOINT=http://127.0.0.1:13145
BRAINSTEM_BASE_GATEWAY_LISTEN=0.0.0.0:5053
BRAINSTEM_DDS_ENABLED=true
LINGTU_DDS_DOMAIN=0
LINGTU_HOST_BOOT_ID=*
BRAINSTEM_DDS_CROSS_BOARD_CLOCK=true
BRAINSTEM_DDS_CLIENT_ID=local-grpc@bsrl1
BRAINSTEM_DDS_POLL_HZ=100
BRAINSTEM_DDS_WATCHDOG_MS=200
DOSO_ROBOT_MODEL=thunder
# POSIX 共享内存零拷贝数据面（与 brainstem.env 中的 THUNDER_SHM_IPC_ENABLED 配套开关；未就绪时自动回退 gRPC）
DOSO_SHM_IPC_ENABLED=false
DOSO_SHM_PROPRIO_NAME=/doso_proprio_v1
DOSO_SHM_CMD_NAME=/doso_ext_cmd_v1
DOSO_SHM_POLL_HZ=200
# Board A <-> Board B unicast peer discovery over wired inter-board subnet
# CYCLONEDDS_URI=file:///etc/brainstem/cyclonedds.xml
